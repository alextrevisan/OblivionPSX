VECTOR environmentDistance(VECTOR p, TPE_Unit maxD)
{
  // manually created environment to match the 3D model of it
  TPE_ENV_START( TPE_envGround(p,0),p )
  for(int  i = 0; i < COLLIDER_SIZE; ++i)
  {
    TPE_ENV_NEXT(TPE_envAABox(p, colliders[i].center,colliders[i].size), p);
  }
  //TPE_ENV_NEXT(TPE_envPlane(p,VECTOR(convertValue(0),0,0),VECTOR(-TPE_FRACTIONS_PER_UNIT,0,0), 2000, 2000), p)
  //TPE_ENV_NEXT(TPE_envAABoxInsideAA(p,aabbMin,aabbMax), p)
  TPE_ENV_END
}


