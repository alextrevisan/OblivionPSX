#define gte_getir1( )			\
	({ long r0;					\
	__asm__ volatile (			\
	"mfc2	%0, $9;"			\
	: "=r"( r0 )				\
	:							\
	);							\
	r0; })

/* Get the IR3 register from the GTE */
#define gte_getir3( )			\
	({ long r0;					\
	__asm__ volatile (			\
	"mfc2	%0, $11;"			\
	: "=r"( r0 )				\
	:							\
	);							\
	r0; })

