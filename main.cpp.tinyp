VECTOR TPE_envPlane(VECTOR point, VECTOR center, VECTOR normal, TPE_Unit width, TPE_Unit heigth)
{
    VECTOR point2 = TPE_vec3Minus(point,center);
    if(point2.vz > width)
        return {0,0,0};
    if(point2.vz < -width)
        return {0,0,0};
    return TPE_envHalfPlane(point,center,normal);
}
